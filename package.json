{
  "name": "swapduel",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @swapduel/web dev",
    "dev:server": "pnpm --filter @swapduel/server dev",
